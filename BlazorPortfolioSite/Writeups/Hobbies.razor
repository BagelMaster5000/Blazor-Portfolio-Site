@inherits PageBase

@*Header*@
<Container Width="Width.Is100" TextAlignment="TextAlignment.Center">
	<Heading Size="HeadingSize.Is2">
		My Hobbies!
	</Heading>
	<Heading Size="HeadingSize.Is5">
		Aside from programming, I also enjoy drawing and making stickers!
	</Heading>
</Container>

<Divider />

@*Drawing*@
<Heading Size="HeadingSize.Is3" TextAlignment="TextAlignment.Center"><u>Drawing</u></Heading>
<Container Padding="Padding.Is2">
	<Row Margin="Margin.Is2">
		<Column ColumnSize="ColumnSize.Is5">
			<Image src="portfolioimages/hobbies/hinata.png" Width="Width.Is100" Padding="Padding.Is2" />
			<Image src="portfolioimages/hobbies/ralsei.png" Width="Width.Is100" Padding="Padding.Is2" />
		</Column>
		<Column ColumnSize="ColumnSize.Is7">
			<Container>
                <Paragraph>
                    I really enjoy drawing! I've been drawing since I was a kid and it's always been a lot of fun!
                </Paragraph>
                <Paragraph>
                    I enjoy going to figure drawing classes, and sometimes I do small art conventions and sell stickers and prints and stuff!
                </Paragraph>
				<Paragraph>
					I like drawing cute things, usually game and anime fanart
				</Paragraph>
			</Container>
            <Link To="https://www.instagram.com/bagelmaster5000/" Target="Target.Blank">
			<Div class="clicky-card-link">
				<Card Margin="Margin.Is2" class="outlined-card">
					<CardBody>
						<Row>
							<Column ColumnSize="ColumnSize.Is2">
								<img style="filter:invert(@GlobalVariables.DarkModeColorInvertPercent)" src="icons/instagram.png" height="30px" width="30px" />
							</Column>
							<Column ColumnSize="ColumnSize.Is10">
								<Text TextWeight="TextWeight.Bold" VerticalAlignment="VerticalAlignment.Middle">My Art Instagram!</Text>
							</Column>
						</Row>
					</CardBody>
				</Card>
			</Div>
			</Link>
			<Row Padding="Padding.Is2">
				<Image src="portfolioimages/hobbies/kiki.png" Width="Width.Is100" />
			</Row>
		</Column>
	</Row>

    <Row Margin="Margin.Is2">
        <Column ColumnSize="ColumnSize.Is2" />
        <Column ColumnSize="ColumnSize.Is8">
            <Row Padding="Padding.Is2">
                <Figure>
                    <FigureImage Source="images/self3.jpg" Rounded />
                     <FigureCaption TextAlignment="TextAlignment.Center">
                         Me at an art convention in Lewisville!
                     </FigureCaption>
                 </Figure>
            </Row>
        </Column>
        <Column ColumnSize="ColumnSize.Is2" />
    </Row>
</Container>
